ANTHROPIC_API_KEY=

# Claim path (extraction + coding). Coding judgment is the product, so this
# runs on the strongest model available.
ANTHROPIC_MODEL=claude-opus-5

# Transcript cleanup only -- punctuation repair, not judgment. Regenerates the
# whole transcript as output tokens, so it stays cheap.
ANTHROPIC_UTILITY_MODEL=claude-haiku-4-5

# Stedi sandbox submission (837P claims). Test-mode key from
# stedi.com/create-sandbox -- test keys only reach Stedi's sandbox network.
STEDI_API_KEY=

# Notion-backed persistence (demo only -- synthetic data only, see
# src/repository/Repository.js). An internal integration token from
# notion.so/my-integrations, shared with the "Ruby App Data" page and its
# child databases. Data source IDs (not database IDs) come from the
# `collection://<id>` URL the Notion API/MCP shows for each database.
NOTION_API_KEY=
NOTION_PATIENTS_DATA_SOURCE_ID=
NOTION_CASES_DATA_SOURCE_ID=
NOTION_ENCOUNTERS_DATA_SOURCE_ID=
NOTION_ARTIFACTS_DATA_SOURCE_ID=

PORT=3000
