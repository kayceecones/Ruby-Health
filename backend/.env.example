ANTHROPIC_API_KEY=

# Claim path (extraction + coding). Coding judgment is the product, so this
# runs on the strongest model available.
ANTHROPIC_MODEL=claude-opus-5

# Transcript cleanup only -- punctuation repair, not judgment. Regenerates the
# whole transcript as output tokens, so it stays cheap.
ANTHROPIC_UTILITY_MODEL=claude-haiku-4-5

PORT=3000
